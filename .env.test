# define your env variables for the test env here
APP_ENV=test
APP_DEBUG=1
CORS_ALLOW_ORIGIN='*'
DATABASE_URL=sqlite:///:memory:
APP_SECRET=test_app_secret_for_testing_only
JWT_PASSPHRASE=

LOG_CHANNEL='#test-log'
SLACK_DISABLED=1
SLACK_ENDPOINT='https://example.invalid/slack'
GATEWAY_API_TOKEN=test-token
SMS_DISABLE=1
DEFAULT_SURVEY_EMAIL='survey@example.invalid'
IPINFO_TOKEN=
GEO_IGNORED_ASNS='[]'
DEFAULT_FROM_EMAIL='test@example.invalid'
ECONOMY_EMAIL='economy@example.invalid'
GOOGLE_API_CLIENT_ID=test
GOOGLE_API_CLIENT_SECRET=test
GOOGLE_API_REFRESH_TOKEN=test
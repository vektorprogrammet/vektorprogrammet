<?xml version="1.0" encoding="UTF-8"?>

<!-- http://phpunit.de/manual/4.1/en/appendixes.configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="http://schema.phpunit.de/4.1/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
>
    <php>
        <env name="APP_ENV" value="test" />
        <env name="APP_DEBUG" value="1" />
        <env name="KERNEL_CLASS" value="Kernel" />
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled" />
    </php>
    <testsuites>
        <!--
            The "unit" suite is declared by EXCLUSION, not enumeration: it is
            "every test under tests/ that a slower, more specific suite below
            does not claim". Suite membership is therefore a pure function of
            the filesystem, so a newly added test directory cannot be silently
            orphaned. (It was: tests/App/ existed for ~30 tests that no suite
            declared, so `composer test` never ran them.)

            Adding a new directory here is only correct when a suite below
            claims it. tests/Unit/PhpUnitSuiteCoverageTest.php enforces that.
        -->
        <testsuite name="unit">
            <directory>tests</directory>
            <exclude>tests/AppBundle/Controller</exclude>
            <exclude>tests/AppBundle/Availability</exclude>
            <exclude>tests/AppBundle/Api</exclude>
        </testsuite>
        <testsuite name="controller">
            <directory>tests/AppBundle/Controller</directory>
        </testsuite>
        <testsuite name="availability">
            <directory>tests/AppBundle/Availability</directory>
        </testsuite>
        <testsuite name="api">
            <directory>tests/AppBundle/Api</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>var</directory>
            <directory>tests</directory>

        </exclude>
    </coverage>
    <extensions>
        <extension class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>
</phpunit>

{
    "name": "vektorprogrammet/vektorprogrammet",
    "description": "Vektorprogrammet's website",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "AppBundle\\": "src/AppBundle"
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^2.20",
        "incenteev/composer-parameter-handler": "^2.0",
        "symfony/monolog-bundle": "^3.10",
        "symfony/polyfill-apcu": "^1.0",
        "twig/twig": "^3.20",
        "php": ">=8.5.12",
        "doctrine/dbal": "^3.10",
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "knplabs/knp-paginator-bundle": "^6.0",
        "helios-ag/fm-elfinder-bundle": "^14.0",
        "liip/imagine-bundle": "^2.18",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "google/apiclient": "^2.18",
        "ramsey/uuid": "^4.7",
        "excelwebzone/recaptcha-bundle": "^1.5",
        "sentry/sentry-symfony": "^5.0",
        "friendsofsymfony/rest-bundle": "^3.8",
        "symfony/serializer": "^6.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "dompdf/dompdf": "^3.1",
        "doctrine/annotations": "^2.0",
        "twig/extra-bundle": "^3.20",
        "twig/intl-extra": "^3.20",
        "friendsofsymfony/ckeditor-bundle": "^2.8",
        "php-http/guzzle7-adapter": "^1.0",
        "swiftmailer/swiftmailer": "^6.3",
        "ext-intl": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "symfony/asset": "^6.4",
        "symfony/cache": "^6.4",
        "symfony/clock": "^6.4",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/doctrine-bridge": "^6.4",
        "symfony/error-handler": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/expression-language": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/finder": "^6.4",
        "symfony/form": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-client": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/monolog-bridge": "^6.4",
        "symfony/options-resolver": "^6.4",
        "symfony/password-hasher": "^6.4",
        "symfony/property-access": "^6.4",
        "symfony/property-info": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/security-bundle": "^6.4",
        "symfony/security-core": "^6.4",
        "symfony/security-csrf": "^6.4",
        "symfony/security-http": "^6.4",
        "symfony/string": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/twig-bridge": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/var-exporter": "^6.4",
        "symfony/yaml": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/mime": "^6.4",
        "symfony/process": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "^3.90",
        "nelmio/cors-bundle": "^2.5",
        "symfony/browser-kit": "^6.4",
        "symfony/css-selector": "^6.4",
        "symfony/debug-bundle": "^6.4",
        "symfony/dom-crawler": "^6.4",
        "symfony/stopwatch": "^6.4",
        "symfony/var-dumper": "^6.4",
        "symfony/web-profiler-bundle": "^6.4"
    },
    "scripts": {
        "symfony-scripts": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "@php bin/console cache:clear",
            "@php bin/console assets:install web --relative"
        ],
        "post-install-cmd": [
            "@symfony-scripts"
        ],
        "post-update-cmd": [
            "@symfony-scripts"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "component-dir": "web/assets",
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-web-dir": "web",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-tests-dir": "tests",
        "branch-alias": null,
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}

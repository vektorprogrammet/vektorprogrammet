{
    "name": "vektorprogrammet/vektorprogrammet",
    "description": "Vektorprogrammet's website",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/App"
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "vendor/symfony/symfony/src/Symfony/Component/VarDumper/Resources/functions/dump.php"
        ]
    },
    "require": {
        "php": ">=7.1",
        "symfony/symfony": "3.4.*",
        "symfony/monolog-bundle": "^3.1.0",
        "symfony/polyfill-apcu": "^1.0",
        "symfony/swiftmailer-bundle": "^3.2.3",
        "symfony/serializer": "3.4.*",
        "sensio/framework-extra-bundle": "^5.0.0",
        "doctrine/doctrine-bundle": "^1.6",
        "doctrine/orm": "^2.5",
        "doctrine/dbal": "~2.8",
        "doctrine/doctrine-fixtures-bundle": "^3.0.2",
        "doctrine/doctrine-migrations-bundle": "^2.2",
        "twig/twig": "^2.0",
        "friendsofsymfony/ckeditor-bundle": "^1.2",
        "knplabs/knp-paginator-bundle": "~2.8",
        "helios-ag/fm-elfinder-bundle": "^9.1",
        "liip/imagine-bundle": "^2.1",
        "google/apiclient": "^2.2",
        "ramsey/uuid": "^3.7",
        "excelwebzone/recaptcha-bundle": "^1.5",
        "sentry/sentry-symfony": "^3.0",
        "friendsofsymfony/rest-bundle": "^2.5",
        "dompdf/dompdf": "^1.0",
        "laminas/laminas-zendframework-bridge": "^1.4",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.4",
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "^2.0",
        "nelmio/cors-bundle": "^1.5"
    },
    "scripts": {
    },
    "config": {
        "bin-dir": "bin",
        "component-dir": "web/assets",
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "robloach/component-installer": true
        }
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-web-dir": "web",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-tests-dir": "tests",
        "branch-alias": null,
        "symfony-assets-install": "relative"
    }
}

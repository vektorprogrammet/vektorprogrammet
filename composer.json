{
    "name": "vektorprogrammet/vektorprogrammet",
    "description": "Vektorprogrammet's website",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/App"
        },
        "classmap": [
            "src/Kernel.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.1",
        "symfony/framework-bundle": "4.4.*",
        "symfony/security-bundle": "4.4.*",
        "symfony/twig-bundle": "4.4.*",
        "symfony/monolog-bundle": "^3.5",
        "symfony/swiftmailer-bundle": "^3.4",
        "symfony/form": "4.4.*",
        "symfony/validator": "4.4.*",
        "symfony/serializer": "4.4.*",
        "symfony/security-csrf": "4.4.*",
        "symfony/asset": "4.4.*",
        "symfony/expression-language": "4.4.*",
        "symfony/http-foundation": "4.4.*",
        "symfony/http-kernel": "4.4.*",
        "symfony/routing": "4.4.*",
        "symfony/console": "4.4.*",
        "symfony/dom-crawler": "4.4.*",
        "symfony/css-selector": "4.4.*",
        "symfony/var-dumper": "4.4.*",
        "symfony/yaml": "4.4.*",
        "symfony/config": "4.4.*",
        "symfony/dependency-injection": "4.4.*",
        "symfony/event-dispatcher": "4.4.*",
        "symfony/finder": "4.4.*",
        "symfony/cache": "4.4.*",
        "symfony/dotenv": "4.4.*",
        "symfony/error-handler": "4.4.*",
        "symfony/polyfill-apcu": "^1.0",
        "sensio/framework-extra-bundle": "^5.6",
        "doctrine/doctrine-bundle": "^2.0",
        "doctrine/orm": "^2.5",
        "doctrine/dbal": "~2.8",
        "doctrine/doctrine-fixtures-bundle": "^3.0.2",
        "doctrine/doctrine-migrations-bundle": "^2.2",
        "twig/twig": "^2.14",
        "twig/extra-bundle": "^2.0||^3.0",
        "friendsofsymfony/ckeditor-bundle": "^1.2",
        "knplabs/knp-paginator-bundle": "^5.0",
        "helios-ag/fm-elfinder-bundle": "^10.0",
        "liip/imagine-bundle": "^2.1",
        "google/apiclient": "^2.2",
        "ramsey/uuid": "^3.7",
        "excelwebzone/recaptcha-bundle": "^1.5",
        "sentry/sentry-symfony": "^3.0",
        "friendsofsymfony/rest-bundle": "^2.8",
        "dompdf/dompdf": "^1.0",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.4",
        "symfony/debug-bundle": "4.4.*",
        "symfony/web-profiler-bundle": "4.4.*",
        "symfony/web-server-bundle": "4.4.*",
        "symfony/browser-kit": "4.4.*",
        "symfony/phpunit-bridge": "4.4.*",
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "^2.0",
        "nelmio/cors-bundle": "^1.5"
    },
    "scripts": {
    },
    "config": {
        "bin-dir": "bin",
        "component-dir": "public/assets",
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "robloach/component-installer": true,
            "symfony/flex": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "4.4.*"
        }
    }
}
